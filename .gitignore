# =============================================================================
# .gitignore for the DADA2 PacBio HiFi 16S Workflow
# =============================================================================

# R and RStudio user state
.Rhistory
.Rapp.history
.RData
*.RData
.Ruserdata
.Rproj.user/
*.Rproj.user
.Renviron

# Pipeline outputs are regenerated by running the notebooks. The GitHub
# Markdown guides under R/notebooks/ and the executed example HTML reports
# under example/reference_results/reports/ remain tracked documentation.
results/
**/checkpoints/
**/console_output/

# Users provide their own sequencing reads locally. Keep data/fastq/.gitkeep,
# but do not publish FASTQ records or delivery archives.
data/fastq/**/*.fastq
data/fastq/**/*.fastq.gz
data/fastq/**/*.fq
data/fastq/**/*.fq.gz
data/fastq/**/*.zip

# Project-local executables, virtual environments, compiled binaries, and
# downloaded taxonomy databases are recreated by the scripts in setup/.
tools/
*.conda
__pycache__/
*.pyc

# Temporary files and operating-system metadata
*.tmp
*.temp
*~
.~*
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
.fuse_hidden*
.directory
.Trash-*
.nfs*

# R package build products
/*.tar.gz
/*.Rcheck/
.Rbuildignore
vignettes/*.html
vignettes/*.pdf
inst/doc

# Notebook dependency folders are not needed because reports are self-contained.
R/notebooks/*_files/

# PDFs, tables, logs, and archives produced outside ignored results folders
*.pdf
*.log
logs/
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Editor files
.vscode/
*.code-workspace
*.swp
*.swo
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
*.sublime-workspace
*.sublime-project

# Secrets and credentials
.env
.env.local
*.pem
*.key
credentials/
secrets/
.positai

# Bundled example: generated reruns stay local, while the small source archive
# and curated reference deliverables are intentionally versioned.
example/run_results/
!example/data/fastq/
!example/data/fastq/**/
!example/data/fastq/**/*.fastq.zip
!example/reference_results/**/*.pdf
!example/reference_results/**/*.RData
